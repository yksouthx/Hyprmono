window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"(?i)^spotify$"#
    open-on-workspace "Music"
}

window-rule {
    match app-id=r#"(?i)^com\.spotify\.Client$"#
    open-on-workspace "Music"
}

window-rule {
    match is-active=true
    opacity 1.0
}

window-rule {
    match is-active=false
    opacity 0.96
}
