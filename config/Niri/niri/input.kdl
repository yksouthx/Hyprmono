input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
        click-method "clickfinger"
        scroll-factor 0.7
        dwt
    }

    mouse {
        natural-scroll
    }

    warp-mouse-to-focus
    focus-follows-mouse
}
