input {
    keyboard {
        xkb {
            layout "pl"
        numlock
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        click-method "clickfinger"
        scroll-factor 0.7
        dwt
    }

    mouse {
    }

    warp-mouse-to-focus
    focus-follows-mouse
}
