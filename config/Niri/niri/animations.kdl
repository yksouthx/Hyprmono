animations {
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    window-open {
        duration-ms 180
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 140
        curve "ease-out-cubic"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
    }
}
