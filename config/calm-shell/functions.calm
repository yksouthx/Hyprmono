[functions]
mkcd = """
mkdir -p "$1" && cd "$1"
"""

extract = """
if [ -z "$1" ]; then
    echo "usage: extract <file>"
    return 1
fi
case "$1" in
    *.tar.gz|*.tgz) tar xzf "$1" ;;
    *.tar.bz2|*.tbz2) tar xjf "$1" ;;
    *.tar) tar xf "$1" ;;
    *.zip) unzip "$1" ;;
    *.gz) gunzip "$1" ;;
    *) echo "extract: unsupported archive '$1'"; return 1 ;;
esac
"""
