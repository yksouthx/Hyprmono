{
    "enabled": true,
    "paths": {
        "wallpaperDir": "~/.config/hypr/assets"
    },
    "appearance": {
        "rounding": { "scale": 0.85 },
        "spacing": { "scale": 0.9 },
        "padding": { "scale": 0.9 },
        "font": {
            "scale": 1,
            "clock": "JetBrainsMono Nerd Font",
            "workspaces": "JetBrainsMono Nerd Font"
        }
    },
    "bar": {
        "persistent": true,
        "showOnHover": false,
        "scrollActions": {
            "workspaces": true,
            "volume": true,
            "brightness": true
        },
        "workspaces": {
            "shown": 10,
            "activeIndicator": true,
            "showUnoccupied": true,
            "perMonitor": true,
            "showWindows": true,
            "maxWindowIcons": 5
        },
        "activeWindow": {
            "compact": false,
            "showOnHover": true
        },
        "tray": {
            "compact": true
        },
        "clock": {
            "showDate": false,
            "showIcon": false
        },
        "statusIcons": [
            { "id": "lockStatus", "enabled": true },
            { "id": "audio", "enabled": true },
            { "id": "microphone", "enabled": true },
            { "id": "kbLayout", "enabled": false },
            { "id": "network", "enabled": true },
            { "id": "bluetooth", "enabled": true },
            { "id": "battery", "enabled": true }
        ],
        "entries": [
            { "id": "logo", "enabled": true },
            { "id": "workspaces", "enabled": true },
            { "id": "spacer", "enabled": true },
            { "id": "activeWindow", "enabled": true },
            { "id": "spacer", "enabled": true },
            { "id": "tray", "enabled": true },
            { "id": "clock", "enabled": true },
            { "id": "statusIcons", "enabled": true },
            { "id": "power", "enabled": true }
        ]
    },
    "dashboard": {
        "enabled": true,
        "showOnHover": true,
        "showDashboard": true,
        "showMedia": true,
        "showPerformance": true,
        "showWeather": false,
        "mediaUpdateInterval": 1000,
        "resourceUpdateInterval": 5000,
        "performance": {
            "showBattery": true,
            "showGpu": true,
            "showCpu": true,
            "showMemory": true,
            "showStorage": false,
            "showNetwork": true
        }
    },
    "launcher": {
        "enabled": true,
        "showOnHover": false,
        "maxShown": 10,
        "useFuzzy": {
            "apps": true,
            "actions": true,
            "schemes": false,
            "variants": false,
            "wallpapers": false
        }
    },
    "notifs": {
        "expire": true,
        "defaultExpireTimeout": 10000,
        "fullscreenExpireTimeout": 2000,
        "groupPreviewNum": 3,
        "openExpanded": false
    },
    "sidebar": {
        "enabled": true,
        "showOnHover": false
    },
    "session": {
        "enabled": true,
        "commands": {
            "logout": ["logout"],
            "shutdown": ["systemctl", "poweroff"],
            "hibernate": ["systemctl", "hibernate"],
            "reboot": ["systemctl", "reboot"]
        }
    }
}
